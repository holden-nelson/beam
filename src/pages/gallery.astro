---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const galleryModules = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/images/gallery/gallery_*.jpg',
	{ eager: true },
);

const galleryImages = Object.entries(galleryModules)
	.map(([path, module]) => ({
		src: module.default,
		order: Number(path.match(/gallery_(\d+)\.jpg$/)?.[1] ?? 0),
	}))
	.sort((a, b) => a.order - b.order);
---

<Layout title="Gallery | Beam Hair Salon">
	<section
		aria-label="Beam Hair Salon gallery"
		class="mx-auto w-full max-w-[1800px] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16"
	>
		<div class="gallery-grid">
			{
				galleryImages.map(({ src }) => (
					<div>
						<Image
							src={src}
							alt=""
							widths={[480, 720, 960, 1280]}
							sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
							loading="lazy"
							class="h-auto w-full"
						/>
					</div>
				))
			}
		</div>
	</section>

	<style is:inline>
		.gallery-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: start;
			gap: 1rem;
		}

		@media (min-width: 640px) {
			.gallery-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.5rem;
			}
		}

		@media (min-width: 1024px) {
			.gallery-grid {
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 2rem;
			}
		}
	</style>
</Layout>
