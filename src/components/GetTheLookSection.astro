---
import { Image } from 'astro:assets';
import merchImage from '../assets/images/merch.jpg';
---

<section
	class="bg-brand-cream px-6 py-16 sm:px-10 sm:py-24 lg:px-16"
	aria-labelledby="get-the-look-heading"
>
	<div class="mx-auto grid w-full max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-16">
		<div class="overflow-hidden rounded-xl">
			<Image
				src={merchImage}
				alt="Woman wearing a camouflage Beam hat"
				class="aspect-[4/5] h-full w-full object-cover"
				widths={[480, 720, 960, 1280]}
				sizes="(min-width: 1024px) 50vw, 100vw"
				loading="lazy"
			/>
		</div>

		<div class="text-brand-black">
			<h2 id="get-the-look-heading" class="font-heading text-6xl leading-none sm:text-7xl lg:text-8xl">
				Get the look
			</h2>
			<p class="font-body mt-6 max-w-xl text-xl leading-normal sm:mt-8 sm:text-2xl">
				Bad hair day? We'll help you cover it up
			</p>
			<a
				href="/merch"
				class="font-subheading mt-8 inline-flex min-h-11 items-center justify-center rounded-full bg-brand-green px-6 py-2 text-sm font-bold text-white outline-none transition-opacity hover:opacity-75 focus-visible:ring-2 focus-visible:ring-brand-black focus-visible:ring-offset-2 sm:mt-10"
			>
				Shop Merch
			</a>
		</div>
	</div>
</section>
