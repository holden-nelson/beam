---
import { ClientRouter, fade } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookingModal from '../components/BookingModal.astro';
import favicon from '../assets/beam-graphic-blackpink.svg';
import '../styles/global.css';

interface Props {
	title?: string;
	overlayHeader?: boolean;
}

const { title = 'Beam Hair Salon', overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={favicon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body transition:animate="none">
		<div class="flex min-h-screen flex-col bg-brand-cream text-brand-black">
			<SiteHeader overlay={overlayHeader} />
			<main
				transition:name="page-content"
				transition:animate={fade({ duration: 180 })}
				class="flex-1"
			>
				<slot />
			</main>
			<SiteFooter />
			<BookingModal />
		</div>
	</body>
</html>
