meta {
  name: Get Payment
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v2/payments/{{paymentId}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("paymentId")) {
    throw new Error("No paymentId is available. Run Retrieve Order after completing checkout.");
  }
}

tests {
  const body = res.getBody();
  const payment = body.payment;

  test("returns a successful response", function () {
    expect(res.getStatus()).to.equal(200);
    expect(body.errors || []).to.be.an("array").that.is.empty;
    expect(payment).to.be.an("object");
  });

  test("confirms a completed payment for the expected order and location", function () {
    expect(payment.status).to.equal("COMPLETED");
    expect(payment.order_id).to.equal(String(bru.getVar("orderId")));
    expect(payment.location_id).to.equal(String(bru.getEnvVar("locationId")));
  });
}
