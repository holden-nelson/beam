{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-18",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"SQUARE_ENVIRONMENT": "production",
		"SQUARE_LOCATION_ID": "LG3V4VE8FP7T5",
		"SQUARE_CATALOG_CATEGORY_ID": "6JXGUO73X6GGQAMWTIBYXPU6"
	},
	"secrets": {
		"required": ["SQUARE_ACCESS_TOKEN"]
	},
	"routes": [
		{
			"pattern": "beam.hair",
			"custom_domain": true
		},
		{
			"pattern": "www.beam.hair",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	"preview_urls": false
}
